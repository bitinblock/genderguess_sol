# X (Twitter) API v2 app bearer token — https://developer.x.com
X_BEARER_TOKEN=
# The feed to watch. Precedence: X_LIST_ID, then X_QUERY, then X_ACCOUNTS.
# Comma-separated handles or profile URLs; every post from them is scored.
X_ACCOUNTS=LiveSquawk
# X_QUERY=(stocks OR earnings OR Fed OR CPI) lang:en -is:retweet
# X_LIST_ID=
X_MAX_RESULTS=50

# JEV scorer (Claude)
ANTHROPIC_API_KEY=
JEV_MODEL=claude-opus-5-5
JEV_EFFORT=low
JEV_BATCH_SIZE=20
CONFIDENCE_THRESHOLD=70

# Telegram — create a bot with @BotFather; chat id of you, a group, or @channelname
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

POLL_INTERVAL_SECONDS=30
STATE_FILE=./state.json
